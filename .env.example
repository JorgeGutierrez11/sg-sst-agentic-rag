# Copy to .env and fill in local values; .env is git-ignored. See docs/getting-started.md section 3.

# Required: DeepSeek API key used by consultation and diagnosis.
DEEPSEEK_API_KEY=

# Required: comma-separated exact http(s)://host[:port] origins; "*" is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: Hugging Face cache directory (default ~/.cache/huggingface).
# HF_HOME=

# Optional: 1 loads pinned models only from HF_HOME, without network access.
# HF_HUB_OFFLINE=1

# Optional: writable parent directory for the disposable Chroma working copy (default system temp dir).
# RAG_CHROMA_WORKING_DIR=
