# Copy to deploy/.env on the VPS and fill in; deploy/.env is git-ignored. See docs/operations/deployment.md.

# Required: immutable GHCR tags to run (sha-<7>); change them to update or roll back.
BACKEND_TAG=sha-1f518ed
FRONTEND_TAG=sha-9fc8945

# Required: public hostname routed by the Cloudflare Tunnel, without scheme.
PUBLIC_HOSTNAME=sgsst.gimnasiouis.com

# Required: DeepSeek API key used by consultation and diagnosis.
DEEPSEEK_API_KEY=

# Required: Cloudflare Tunnel token (eyJ...) from Networking > Tunnels > <tunnel>.
TUNNEL_TOKEN=

# Optional: host path of the published corpus (default ../data/processed in this checkout).
# CORPUS_DIR=
